{
  "name": "dsh-jukebox",
  "version": "0.7.0",
  "description": "DSH 插件 · 點唱機：本地音樂庫、YT Music 與 bilibili 播放；Spotify、KKBOX、Apple Music 的搜尋與歌單（聲音以對應播放提供，或控制官方播放器並即時轉送）。可登記為 Discord 賽博群友的音樂來源。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "music",
    "player",
    "jukebox"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:client": "node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "music-metadata": "^11.9.0"
  },
  "author": {
    "name": "puffdog-git",
    "url": "https://github.com/puffdog-git"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puffdog-git/dsh-jukebox.git"
  },
  "homepage": "https://github.com/puffdog-git/dsh-jukebox#readme",
  "bugs": {
    "url": "https://github.com/puffdog-git/dsh-jukebox/issues"
  },
  "engines": {
    "node": ">=22.15"
  }
}
